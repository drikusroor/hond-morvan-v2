---
interface Props {
  title: string;
  description?: string;
  headerImage?: string;
}

import "../../public/styles/global.css";
import { Image } from "astro:assets";
import { getImage } from "../utils/images";

const {
  title,
  description = "Vakantiehuis voor hond en baas in de Morvan, Frankrijk",
  headerImage,
} = Astro.props;
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL || "/";
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.webp" />

    <meta name="generator" content={Astro.generator} />
    <title>{title} - HondMorvan</title>

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} - HondMorvan`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/favicon.webp", Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} - HondMorvan`} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={new URL("/favicon.webp", Astro.site)}
    />

    <!-- Fonts - loaded asynchronously to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <header>
      <div class="header-banner">
        {
          headerImage && (
            <Image
              src={getImage(headerImage)}
              alt="HondMorvan - Vakantiehuis in de Morvan"
              loading="eager"
              fetchpriority="high"
              widths={[640, 1024, 1333]}
              sizes="100vw"
            />
          )
        }
      </div>
    </header>

    <nav class="main-nav">
      <div class="container">
        <ul>
          <li>
            <a
              href={baseUrl}
              class={currentPath === "/" || currentPath === baseUrl
                ? "active"
                : ""}>Home</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}fotogalerij/`}
              class={currentPath.includes("/fotogalerij") ? "active" : ""}
              >Fotogalerij</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}kaart/`}
              class={currentPath.includes("/kaart") ? "active" : ""}>Kaart</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}gastenboek/`}
              class={currentPath.includes("/gastenboek") ? "active" : ""}
              >Gastenboek</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}tarieven/`}
              class={currentPath.includes("/tarieven") ? "active" : ""}
              >Tarieven</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}links/`}
              class={currentPath.includes("/links") ? "active" : ""}>Links</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}contact/`}
              class={currentPath.includes("/contact") ? "active" : ""}
              >Contact</a
            >
          </li>
        </ul>
      </div>
    </nav>

    <main class="base-layout-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        <p>
          &copy; {new Date().getFullYear()} HondMorvan - Vakantiehuis in de Morvan
        </p>
        <p>
          <a href="mailto:info@hondmorvan.nl">info@hondmorvan.nl</a> |
          <a href="tel:+31651121073">+31 6 51121073</a>
        </p>
        <p>
          Website door <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://kokokoding.nl">Koko Koding</a
          >
        </p>
      </div>
    </footer>

    <script>
      const nav = document.querySelector(".main-nav");
      let lastScrollTop = 0;

      // Detect if nav is stuck by checking if scroll is past the header
      const header = document.querySelector("header");

      window.addEventListener("scroll", () => {
        if (window.scrollY > (header?.offsetHeight || 0)) {
          nav?.classList.add("is-sticky");
        } else {
          nav?.classList.remove("is-sticky");
        }
      });
    </script>
  </body>
</html>
