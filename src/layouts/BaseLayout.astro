---
interface Props {
  title: string;
  description?: string;
}

import { IMAGES, getImagePath } from '../utils/images';

const { title, description = "Vakantiehuis voor hond en baas in de Morvan, Frankrijk" } = Astro.props;
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL || '/';

// Determine the header image based on current path
const getHeaderImage = (path: string): string => {
  if (path.includes('/contact')) return IMAGES.HEADER_CONTACT;
  if (path.includes('/gastenboek')) return IMAGES.HEADER_GASTENBOEK;
  if (path.includes('/kaart')) return IMAGES.HEADER_KAART;
  if (path.includes('/links')) return IMAGES.HEADER_LINKS;
  if (path.includes('/tarieven')) return IMAGES.HEADER_TARIEVEN;
  return IMAGES.HEADER_HOME;
};

const headerImage = getHeaderImage(currentPath);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - HondMorvan</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <header>
      <div class="header-banner">
        <img src={getImagePath(headerImage)} alt="HondMorvan - Vakantiehuis in de Morvan" />
      </div>
      <nav class="main-nav">
        <div class="container">
          <ul>
            <li><a href={baseUrl} class={currentPath === "/" || currentPath === baseUrl ? "active" : ""}>Home</a></li>
            <li><a href={`${baseUrl}kaart`} class={currentPath.includes("/kaart") ? "active" : ""}>Kaart</a></li>
            <li><a href={`${baseUrl}gastenboek`} class={currentPath.includes("/gastenboek") ? "active" : ""}>Gastenboek</a></li>
            <li><a href={`${baseUrl}tarieven`} class={currentPath.includes("/tarieven") ? "active" : ""}>Tarieven</a></li>
            <li><a href={`${baseUrl}links`} class={currentPath.includes("/links") ? "active" : ""}>Links</a></li>
            <li><a href={`${baseUrl}contact`} class={currentPath.includes("/contact") ? "active" : ""}>Contact</a></li>
          </ul>
        </div>
      </nav>
    </header>

    <main class="base-layout-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} HondMorvan - Vakantiehuis in de Morvan</p>
        <p>
          <a href="mailto:info@hondmorvan.nl">info@hondmorvan.nl</a> | 
          <a href="tel:+31651121073">+31 6 51121073</a>
        </p>
        <p>
          Website door <a target="_blank" rel="noopener noreferrer" href="https://kokokoding.nl">Koko Koding</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --color-background: #FFC58A;
        --color-primary: #993300;
        --color-text: #2c3e50;
        --color-text-light: #666;
        --color-white: #ffffff;
        --color-accent: #FFFF00;
        --color-baby-blue: #89CFF0;
        
        --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        
        --spacing-xs: 0.5rem;
        --spacing-sm: 1rem;
        --spacing-md: 1.5rem;
        --spacing-lg: 2rem;
        --spacing-xl: 3rem;
        
        --max-width: 1200px;
        --border-radius: 8px;
        --border-radius-rounded: 50px;
      }
      
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: var(--font-family);
        line-height: 1.6;
        color: var(--color-text);
        background-color: var(--color-background);
      }
      
      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--spacing-md);
      }
      
      /* Header */
      header {
      }
      
      .header-banner {
        width: 100%;
        height: 338px;
        overflow: hidden;
      }
      
      .header-banner img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: left bottom;
      }
      
      .main-nav .container {
        padding: var(--spacing-md) 0;
      }
      
      .main-nav ul {
        display: flex;
        gap: var(--spacing-md);
        list-style: none;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 0;
      }
      
      .main-nav a {
        text-decoration: none;
        color: var(--color-text);
        font-weight: 600;
        padding: var(--spacing-xs) var(--spacing-sm);
        border-radius: var(--border-radius-rounded);
        border: none;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: inline-block;
        position: relative;
        overflow: hidden;

        /* Liquid design with smooth gradients and organic shapes */
        background: linear-gradient(135deg, var(--color-white) 0%, var(--color-baby-blue) 100%);
        box-shadow: 0 4px 15px rgba(137, 207, 240, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.6);
      }
      
      .main-nav a:hover,
      .main-nav a.active {
        background: linear-gradient(135deg, var(--color-primary) 0%, #6b2400 100%);
        color: var(--color-white);
        box-shadow: 0 8px 25px rgba(153, 51, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
      }
      main {
        min-height: calc(100vh - 200px);
        padding: var(--spacing-xl) 0;
      }
      
      .base-layout-main {
        min-height: calc(100vh - 200px);
        padding: 0 0 var(--spacing-xl) 0;
      }
      
      /* Typography */
      h1 {
        font-size: 2.5rem;
        color: var(--color-primary);
        margin-bottom: var(--spacing-md);
      }
      
      h2 {
        font-size: 2rem;
        color: var(--color-primary);
        margin-top: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
      }
      
      h3 {
        font-size: 1.5rem;
        color: var(--color-primary);
        margin-top: var(--spacing-md);
        margin-bottom: var(--spacing-sm);
      }
      
      p {
        margin-bottom: var(--spacing-md);
      }
      
      a {
        color: var(--color-primary);
        text-decoration: underline;
      }
      
      a:hover {
        color: #661100;
      }
      
      strong {
        color: var(--color-primary);
      }
      
      em {
        font-style: italic;
      }
      
      /* Lists */
      ul, ol {
        margin-left: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
      }
      
      li {
        margin-bottom: var(--spacing-xs);
      }
      
      /* Footer */
      footer {
        background-color: var(--color-primary);
        color: var(--color-white);
        padding: var(--spacing-lg) 0;
        text-align: center;
      }
      
      footer a {
        color: var(--color-white);
        text-decoration: none;
      }
      
      footer a:hover {
        text-decoration: underline;
      }
      
      /* Responsive */
      @media (max-width: 768px) {
        .header-banner {
          height: 180px;
        }

        .header-banner img {
          max-height: 180px;
        }
        
        .main-nav ul {
          gap: var(--spacing-sm);
        }

        .main-nav li {
          margin-bottom: 0;
        }
        
        .main-nav a {
          font-size: 0.9rem;
          padding: var(--spacing-xs) var(--spacing-xs);
        }
        
        h1 {
          font-size: 2rem;
        }
        
        h2 {
          font-size: 1.5rem;
        }
      }
    </style>
  </body>
</html>
