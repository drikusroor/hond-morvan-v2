---
interface HeaderImage {
  src: string;
  alt?: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  description?: string;
  headerImage?: HeaderImage;
}

import { IMAGES, getImagePath, globImages } from "../utils/images";
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const {
  title,
  description = "Vakantiehuis voor hond en baas in de Morvan, Frankrijk",
  headerImage,
} = Astro.props;
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL || "/";

// Use CMS header image if provided, otherwise use default based on current path
const finalHeaderImage = headerImage;

// if (!globImages[finalHeaderImage]) {
//   throw new Error(
//     `"${finalHeaderImage}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,webp}"`,
//   );
// }
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />
    <title>{title} - HondMorvan</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <div class="header-banner">
        <!-- <Image
          src={globImages[finalHeaderImage.src]}
          alt="HondMorvan - Vakantiehuis in de Morvan"
          width={finalHeaderImage.width}
          height={finalHeaderImage.height}
        /> -->
      </div>
    </header>

    <nav class="main-nav">
      <div class="container">
        <ul>
          <li>
            <a
              href={baseUrl}
              class={currentPath === "/" || currentPath === baseUrl
                ? "active"
                : ""}>Home</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}kaart`}
              class={currentPath.includes("/kaart") ? "active" : ""}>Kaart</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}gastenboek`}
              class={currentPath.includes("/gastenboek") ? "active" : ""}
              >Gastenboek</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}tarieven`}
              class={currentPath.includes("/tarieven") ? "active" : ""}
              >Tarieven</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}links`}
              class={currentPath.includes("/links") ? "active" : ""}>Links</a
            >
          </li>
          <li>
            <a
              href={`${baseUrl}contact`}
              class={currentPath.includes("/contact") ? "active" : ""}
              >Contact</a
            >
          </li>
        </ul>
      </div>
    </nav>

    <main class="base-layout-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        <p>
          &copy; {new Date().getFullYear()} HondMorvan - Vakantiehuis in de Morvan
        </p>
        <p>
          <a href="mailto:info@hondmorvan.nl">info@hondmorvan.nl</a> |
          <a href="tel:+31651121073">+31 6 51121073</a>
        </p>
        <p>
          Website door <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://kokokoding.nl">Koko Koding</a
          >
        </p>
      </div>
    </footer>

    <script>
      const nav = document.querySelector(".main-nav");
      let lastScrollTop = 0;

      // Detect if nav is stuck by checking if scroll is past the header
      const header = document.querySelector("header");

      window.addEventListener("scroll", () => {
        if (window.scrollY > (header?.offsetHeight || 0)) {
          nav?.classList.add("is-sticky");
        } else {
          nav?.classList.remove("is-sticky");
        }
      });
    </script>
  </body>
</html>
