---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "beschikbaarheid");

if (!page) {
  throw new Error("Page 'beschikbaarheid' not found");
}

const { Content } = await page.render();

const bookings = await getCollection("bookings");

// Sort bookings by start date
const sortedBookings = bookings.sort(
  (a, b) => a.data.startDate.getTime() - b.data.startDate.getTime(),
);

// Get current date
const today = new Date();
today.setHours(0, 0, 0, 0);

// Filter future and current bookings
const upcomingBookings = sortedBookings.filter(
  (booking) => booking.data.endDate >= today,
);

// Helper function to format dates
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("nl-NL", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);
};

// Helper function to get status color
const getStatusColor = (status: string) => {
  switch (status) {
    case "gereserveerd":
      return "#dc2626"; // red
    case "optie":
      return "#fbbf24"; // yellow
    case "geblokkeerd":
      return "#4b5563"; // dark gray
    default:
      return "#4b5563";
  }
};

// Helper function to get status label
const getStatusLabel = (status: string) => {
  switch (status) {
    case "gereserveerd":
      return "Gereserveerd";
    case "optie":
      return "Optie";
    case "geblokkeerd":
      return "Niet beschikbaar";
    default:
      return status;
  }
};

// Generate calendar data for April through November
const generateCalendarData = () => {
  const months = [];

  // Determine which year's season to show
  // If we're in Dec-March, show the upcoming season (next year)
  // If we're in Apr-Nov, show current year's season
  const currentMonth = today.getMonth();
  const currentYear = today.getFullYear();
  const startYear =
    currentMonth >= 11 || currentMonth < 3 ? currentYear + 1 : currentYear;

  // Generate April (3) through November (10) = 8 months
  for (let m = 3; m <= 10; m++) {
    const monthDate = new Date(startYear, m, 1);
    const year = monthDate.getFullYear();
    const monthIndex = monthDate.getMonth();
    const monthName = new Intl.DateTimeFormat("nl-NL", {
      month: "long",
      year: "numeric",
    }).format(monthDate);

    const firstDay = new Date(year, monthIndex, 1);
    const lastDay = new Date(year, monthIndex + 1, 0);
    const daysInMonth = lastDay.getDate();
    const startingDayOfWeek = firstDay.getDay();

    const days = [];

    // Add empty cells
    for (
      let j = 0;
      j < (startingDayOfWeek === 0 ? 6 : startingDayOfWeek - 1);
      j++
    ) {
      days.push({ day: null, bookings: [] });
    }

    // Add actual days
    for (let day = 1; day <= daysInMonth; day++) {
      const currentDate = new Date(year, monthIndex, day);
      currentDate.setHours(0, 0, 0, 0);

      const dayBookings = upcomingBookings.filter((booking) => {
        const start = new Date(booking.data.startDate);
        const end = new Date(booking.data.endDate);
        start.setHours(0, 0, 0, 0);
        end.setHours(0, 0, 0, 0);
        return currentDate >= start && currentDate <= end;
      });

      days.push({
        day,
        bookings: dayBookings,
        status: dayBookings.length > 0 ? dayBookings[0].data.status : null,
      });
    }

    months.push({ monthName, days });
  }

  return months;
};

const calendarMonths = generateCalendarData();
---

<BaseLayout
  title="Beschikbaarheid"
  description="Bekijk de beschikbaarheid van ons vakantiehuis"
  headerImage={page.data.headerImage}
>
  <div class="container">
    <div class="intro">
      <h1>Beschikbaarheid</h1>
      <p>
        Neem voor meer informatie en reserveringen s.v.p. contact op met Luda op <a
          href="mailto:info@hondmorvan.nl">info@hondmorvan.nl</a
        > of <a href="tel:+31651121073">+31.651121073</a>.
      </p>
      <div class="legend">
        <div class="legend-item">
          <span class="legend-color" style="background-color: #dc2626;"></span>
          <span>Gereserveerd</span>
        </div>
        <div class="legend-item">
          <span class="legend-color" style="background-color: #fbbf24;"></span>
          <span>Optie</span>
        </div>
        <div class="legend-item">
          <span class="legend-color" style="background-color: #4b5563;"></span>
          <span>Niet beschikbaar</span>
        </div>
      </div>
    </div>

    <Content />

    <div class="availability-view">
      <div class="calendar-grid">
        {
          calendarMonths.map(({ monthName, days }) => (
            <div class="calendar-month">
              <h3>{monthName}</h3>
              <div class="calendar-days">
                <div class="day-header">Ma</div>
                <div class="day-header">Di</div>
                <div class="day-header">Wo</div>
                <div class="day-header">Do</div>
                <div class="day-header">Vr</div>
                <div class="day-header">Za</div>
                <div class="day-header">Zo</div>
                {days.map(({ day, status }) => (
                  <div
                    class:list={[
                      "calendar-day",
                      { empty: !day, booked: status },
                    ]}
                    style={
                      status
                        ? `background-color: ${getStatusColor(status)}; color: white;`
                        : ""
                    }
                    title={status ? getStatusLabel(status) : ""}
                  >
                    {day || ""}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <h3 class="text-center italic">Welkom in de mooie Morvan!</h3>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #1f2937;
  }

  h2 {
    font-size: 1.875rem;
    margin: 2.5rem 0 1.5rem;
    color: #1f2937;
  }

  .intro {
    background-color: #f9fafb;
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
  }

  .intro p {
    margin-bottom: 1rem;
    color: #4b5563;
    line-height: 1.6;
  }

  .legend {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-color {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    display: inline-block;
  }

  .availability-view {
    margin: 2rem 0;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .calendar-month {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 0.75rem;
  }

  .calendar-month h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: #1f2937;
    text-align: center;
  }

  .calendar-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .day-header {
    text-align: center;
    font-weight: 600;
    font-size: 0.875rem;
    color: #6b7280;
    padding: 0.5rem 0;
  }

  .calendar-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    background-color: #f9fafb;
    border-radius: 4px;
    cursor: default;
    transition: all 0.2s;
  }

  .calendar-day.empty {
    background-color: transparent;
  }

  .calendar-day.booked {
    font-weight: 600;
  }

  .calendar-day:not(.empty):not(.booked):hover {
    background-color: #e5e7eb;
  }

  .bookings-list {
    margin: 3rem 0;
  }

  .bookings {
    display: grid;
    gap: 1rem;
  }

  .booking-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    transition: box-shadow 0.2s;
  }

  .booking-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .booking-dates {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1rem;
  }

  .arrow {
    color: #9ca3af;
    font-size: 1.25rem;
  }

  .booking-status {
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .no-bookings {
    text-align: center;
    padding: 3rem;
    color: #6b7280;
    font-style: italic;
  }

  .contact-cta {
    background: linear-gradient(135deg, #993300 0%, #6b2400 100%);
    color: white;
    padding: 2rem;
    border-radius: 0.5rem;
    text-align: center;
    margin-top: 3rem;
    box-shadow: 0 4px 15px rgba(153, 51, 0, 0.3);
  }

  .contact-cta h2 {
    color: white;
    margin-top: 0;
  }

  .contact-cta p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
    opacity: 0.95;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: linear-gradient(135deg, #ffffff 0%, #89cff0 100%);
    color: #993300;
    text-decoration: none;
    border-radius: 0.375rem;
    font-weight: 600;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    box-shadow:
      0 4px 15px rgba(137, 207, 240, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 8px 25px rgba(153, 51, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    background: linear-gradient(135deg, #89cff0 0%, #ffffff 100%);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .calendar-grid {
      grid-template-columns: 1fr;
    }

    .legend {
      flex-direction: column;
      gap: 0.75rem;
    }

    .booking-dates {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .arrow {
      transform: rotate(90deg);
    }
  }
</style>
