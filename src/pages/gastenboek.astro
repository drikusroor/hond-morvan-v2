---
import PageWithSidebars from "../layouts/PageWithSidebars.astro";
import { getCollection, getEntry } from "astro:content";

const testimonials = await getCollection("testimonials");
const sortedTestimonials = testimonials.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Get the gastenboek page data for potential CMS images
const page = await getEntry("pages", "links");
---

<PageWithSidebars
  title="Gastenboek"
  description="Lees wat onze gasten zeggen over hun verblijf"
  leftSidebar={page.data.leftColumnImages}
  rightSidebar={page.data.rightColumnImages}
>
  <h1>Gastenboek</h1>

  <div class="testimonials">
    {
      sortedTestimonials.map(async (testimonial) => {
        const { Content } = await testimonial.render();
        return (
          <article class="testimonial">
            <div class="testimonial-header">
              <div>
                <h3>{testimonial.data.name}</h3>
                {testimonial.data.location && (
                  <p class="location">📍 {testimonial.data.location}</p>
                )}
              </div>
              <div class="meta">
                <p class="date">
                  {testimonial.data.date.toLocaleDateString("nl-NL", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </p>
              </div>
            </div>
            <div class="testimonial-content">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</PageWithSidebars>

<style>
  .testimonials {
    display: grid;
    gap: 1.5rem;
  }

  .testimonial {
    border-bottom: 2px dashed var(--color-primary);
  }

  .testimonial-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    /* border-bottom: 2px solid var(--color-background); */
  }

  .testimonial h3 {
    color: var(--color-primary);
    margin: 0 0 0.25rem 0;
  }

  .location {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin: 0;
  }

  .meta {
    text-align: right;
  }

  .date {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .rating {
    font-size: 1.2rem;
    margin: 0;
  }

  .testimonial-content {
    color: var(--color-text);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .testimonial-header {
      flex-direction: column;
      gap: 1rem;
    }

    .meta {
      text-align: left;
    }
  }
</style>
