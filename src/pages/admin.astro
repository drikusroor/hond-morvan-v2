---
// This page loads the Decap CMS admin interface
---

<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>HondMorvan Beheer</title>
  <script>
    // Inline CMS configuration
    window.CMS_MANUAL_INIT = true;
  </script>
</head>
<body>
  <!-- Include the Decap CMS script -->
  <script src="https://unpkg.com/decap-cms@^3.1.2/dist/decap-cms.js"></script>
  
  <script>
    // Initialize CMS with inline config
    CMS.init({
      config: {
        backend: {
          name: 'test-repo'
        },
        publish_mode: 'editorial_workflow',
        locale: 'nl',
        media_folder: 'public/images/uploads',
        public_folder: '/images/uploads',
        collections: [
          {
            name: 'pages',
            label: "Pagina's",
            files: [
              {
                label: 'Home',
                name: 'home',
                file: 'src/content/pages/home.md',
                fields: [
                  { label: 'Titel', name: 'title', widget: 'string' },
                  { label: 'Beschrijving', name: 'description', widget: 'text', required: false },
                  { label: 'Inhoud', name: 'body', widget: 'markdown' }
                ]
              },
              {
                label: 'Contact',
                name: 'contact',
                file: 'src/content/pages/contact.md',
                fields: [
                  { label: 'Titel', name: 'title', widget: 'string' },
                  { label: 'Beschrijving', name: 'description', widget: 'text', required: false },
                  { label: 'Inhoud', name: 'body', widget: 'markdown' }
                ]
              },
              {
                label: 'Tarieven',
                name: 'tarieven',
                file: 'src/content/pages/tarieven.md',
                fields: [
                  { label: 'Titel', name: 'title', widget: 'string' },
                  { label: 'Beschrijving', name: 'description', widget: 'text', required: false },
                  { label: 'Inhoud', name: 'body', widget: 'markdown' }
                ]
              },
              {
                label: 'Kaart',
                name: 'kaart',
                file: 'src/content/pages/kaart.md',
                fields: [
                  { label: 'Titel', name: 'title', widget: 'string' },
                  { label: 'Beschrijving', name: 'description', widget: 'text', required: false },
                  { label: 'Inhoud', name: 'body', widget: 'markdown' }
                ]
              },
              {
                label: 'Links',
                name: 'links',
                file: 'src/content/pages/links.md',
                fields: [
                  { label: 'Titel', name: 'title', widget: 'string' },
                  { label: 'Beschrijving', name: 'description', widget: 'text', required: false },
                  { label: 'Inhoud', name: 'body', widget: 'markdown' }
                ]
              }
            ]
          },
          {
            name: 'testimonials',
            label: 'Gastenboek',
            label_singular: 'Review',
            folder: 'src/content/testimonials',
            create: true,
            slug: '{{year}}-{{month}}-{{slug}}',
            fields: [
              { label: 'Gast naam', name: 'name', widget: 'string' },
              { label: 'Datum', name: 'date', widget: 'datetime', date_format: 'DD/MM/YYYY', time_format: false },
              { label: 'Locatie', name: 'location', widget: 'string', required: false },
              { label: 'Beoordeling', name: 'rating', widget: 'number', value_type: 'float', min: 1, max: 5, step: 0.5, default: 5 },
              { label: 'Foto', name: 'photo', widget: 'image', required: false },
              { label: 'Bericht', name: 'body', widget: 'text' }
            ]
          }
        ]
      }
    });
  </script>
</body>
</html>
