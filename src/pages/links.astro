---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'links');
const { Content } = await page.render();

const leftSidebar = [
  { src: '/images/hondmorvan-linklinks1.png', alt: 'HondMorvan links links 1' },
  { src: '/images/hondmorvan-linklinks2.png', alt: 'HondMorvan links links 2' }
];

const rightSidebar = [
  { src: '/images/hondmorvan-linklrechts1.png', alt: 'HondMorvan links rechts 1' },
  { src: '/images/hondmorvan-linklrechts4.png', alt: 'HondMorvan links rechts 4' },
  { src: '/images/hondmorvan-linklrechts3.png', alt: 'HondMorvan links rechts 3' },
  { src: '/images/hondmorvan-linklrechts5.png', alt: 'HondMorvan links rechts 5' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
