---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'home');
const { Content } = await page.render();

const leftSidebar = [
  { src: '/images/hondmorvan-homelinks1.png', alt: 'HondMorvan home links sidebar' }
];

const rightSidebar = [
  { src: '/images/hondmorvan-homerechts1.png', alt: 'HondMorvan home rechts 1' },
  { src: '/images/hondmorvan-homerechts2.png', alt: 'HondMorvan home rechts 2' },
  { src: '/images/hondmorvan-homerechts3.png', alt: 'HondMorvan home rechts 3' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
