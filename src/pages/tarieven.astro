---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'tarieven');
const { Content } = await page.render();

const leftSidebar = [
  { src: '/images/hondmorvan-tarievenlinks1.png', alt: 'HondMorvan tarieven links 1' },
  { src: '/images/hondmorvan-tarievenlinks2.png', alt: 'HondMorvan tarieven links 2' }
];

const rightSidebar = [
  { src: '/images/hondmorvan-tarievenrechts1.png', alt: 'HondMorvan tarieven rechts 1' },
  { src: '/images/hondmorvan-tarievenrechts2.png', alt: 'HondMorvan tarieven rechts 2' },
  { src: '/images/hondmorvan-tarievenrechts4.png', alt: 'HondMorvan tarieven rechts 4' },
  { src: '/images/hondmorvan-tarievenrechts5.png', alt: 'HondMorvan tarieven rechts 5' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
