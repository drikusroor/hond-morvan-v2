---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';
import { IMAGES } from '../utils/images';

const page = await getEntry('pages', 'tarieven');
const { Content } = await page.render();

const leftSidebar = [
  { src: IMAGES.TARIEVEN_LEFT_1, alt: 'HondMorvan tarieven links 1' },
  { src: IMAGES.TARIEVEN_LEFT_2, alt: 'HondMorvan tarieven links 2' }
];

const rightSidebar = [
  { src: IMAGES.TARIEVEN_RIGHT_1, alt: 'HondMorvan tarieven rechts 1' },
  { src: IMAGES.TARIEVEN_RIGHT_2, alt: 'HondMorvan tarieven rechts 2' },
  { src: IMAGES.TARIEVEN_RIGHT_3, alt: 'HondMorvan tarieven rechts 4' },
  { src: IMAGES.TARIEVEN_RIGHT_4, alt: 'HondMorvan tarieven rechts 5' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
