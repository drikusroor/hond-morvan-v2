---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
const { Content } = await page.render();

const leftSidebar = [
  { src: '/images/hondmorvan-contactlinks1.png', alt: 'HondMorvan contact links 1' },
  { src: '/images/hondmorvan-contactlinks2.png', alt: 'HondMorvan contact links 2' }
];

const rightSidebar = [
  { src: '/images/hondmorvan-contactrechts1.png', alt: 'HondMorvan contact rechts 1' },
  { src: '/images/hondmorvan-contactrechts2.png', alt: 'HondMorvan contact rechts 2' },
  { src: '/images/hondmorvan-contactrechts3.png', alt: 'HondMorvan contact rechts 3' },
  { src: '/images/hondmorvan-contactrechts4.png', alt: 'HondMorvan contact rechts 4' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
