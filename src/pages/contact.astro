---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "contact");

if (!page) {
	throw new Error("Page 'contact' not found");
}

const { Content } = await page.render();

const bookings = await getCollection("bookings");

// Sort bookings by start date
const sortedBookings = bookings.sort(
	(a, b) => a.data.startDate.getTime() - b.data.startDate.getTime(),
);

// Get current date
const today = new Date();

// Normalize dates to UTC day keys to avoid timezone shifts
const toDayKey = (date: Date) =>
	Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());

const todayKey = toDayKey(today);

// Filter future and current bookings
const upcomingBookings = sortedBookings.filter(
	(booking) => toDayKey(booking.data.endDate) >= todayKey,
);

// Helper function to get status color
const getStatusColor = (status: string) => {
	switch (status) {
		case "gereserveerd":
			return "#dc2626"; // red
		case "optie":
			return "#fbbf24"; // yellow
		case "geblokkeerd":
			return "#4b5563"; // dark gray
		default:
			return "#4b5563";
	}
};

// Helper function to get status label
const getStatusLabel = (status: string) => {
	switch (status) {
		case "gereserveerd":
			return "Gereserveerd";
		case "optie":
			return "Optie";
		case "geblokkeerd":
			return "Niet beschikbaar";
		default:
			return status;
	}
};

// Settings
// Set to true to only show the next year's calendar when it has bookings
const onlyShowNextYearWhenBooked = false;

// Generate calendar data for April through November of a given year
const generateCalendarData = (year: number) => {
	const months = [];

	// Generate April (3) through November (10) = 8 months
	for (let m = 3; m <= 10; m++) {
		const monthDate = new Date(year, m, 1);
		const monthIndex = monthDate.getMonth();
		const monthName = new Intl.DateTimeFormat("nl-NL", {
			month: "long",
		}).format(monthDate);

		const firstDay = new Date(year, monthIndex, 1);
		const lastDay = new Date(year, monthIndex + 1, 0);
		const daysInMonth = lastDay.getDate();
		const startingDayOfWeek = firstDay.getDay();

		const days = [];

		// Add empty cells
		for (
			let j = 0;
			j < (startingDayOfWeek === 0 ? 6 : startingDayOfWeek - 1);
			j++
		) {
			days.push({ day: null, bookings: [] });
		}

		// Add actual days
		for (let day = 1; day <= daysInMonth; day++) {
			const currentDayKey = Date.UTC(year, monthIndex, day);

			const dayBookings = upcomingBookings.filter((booking) => {
				const startKey = toDayKey(booking.data.startDate);
				const endKey = toDayKey(booking.data.endDate);
				return currentDayKey >= startKey && currentDayKey <= endKey;
			});

			// Check if this day is a changeover day (start or end of booking)
			const startBooking = upcomingBookings.find(
				(booking) => toDayKey(booking.data.startDate) === currentDayKey,
			);

			const endBooking = upcomingBookings.find(
				(booking) => toDayKey(booking.data.endDate) === currentDayKey,
			);

			const isStartDate = Boolean(startBooking);
			const isEndDate = Boolean(endBooking);

			// Determine changeover type
			let changeoverType = null;
			if (isStartDate && isEndDate) {
				changeoverType = "both";
			} else if (isStartDate) {
				changeoverType = "start";
			} else if (isEndDate) {
				changeoverType = "end";
			}

			days.push({
				day,
				bookings: dayBookings,
				status:
					dayBookings.length > 0 ? dayBookings[0].data.status : null,
				changeoverType,
				startStatus: startBooking?.data.status ?? null,
				endStatus: endBooking?.data.status ?? null,
			});
		}

		months.push({ monthName, days });
	}

	return months;
};

// Determine which years to show
// If we're in December, start from next year; otherwise start from current year
const currentMonth = today.getMonth();
const currentYear = today.getFullYear();
const primaryYear = currentMonth === 11 ? currentYear + 1 : currentYear;
const nextYear = primaryYear + 1;

// Check if next year has any bookings
const nextYearHasBookings = upcomingBookings.some((booking) => {
	const startYear = booking.data.startDate.getUTCFullYear();
	const endYear = booking.data.endDate.getUTCFullYear();
	return startYear === nextYear || endYear === nextYear;
});

const showNextYear = !onlyShowNextYearWhenBooked || nextYearHasBookings;

// Build calendar years array
const calendarYears = [
	{ year: primaryYear, months: generateCalendarData(primaryYear) },
	...(showNextYear
		? [{ year: nextYear, months: generateCalendarData(nextYear) }]
		: []),
];
---

<BaseLayout
	title={page.data.title || "Contact"}
	description={page.data.description ||
		"Neem contact op voor meer informatie en beschikbaarheid"}
	headerImage={page.data.headerImage}
>
	<div class="container">
		<div class="intro-block">
			<article class="content">
				<Content />
			</article>

			<div class="legend">
				<div class="legend-item">
					<span
						class="legend-color"
						style="background-color: #dc2626;"></span>
					<span>Gereserveerd</span>
				</div>
				<div class="legend-item">
					<span
						class="legend-color"
						style="background-color: #fbbf24;"></span>
					<span>Optie</span>
				</div>
				<div class="legend-item">
					<span
						class="legend-color"
						style="background-color: #4b5563;"></span>
					<span>Niet beschikbaar</span>
				</div>
				<div class="legend-item">
					<span
						class="legend-color legend-diagonal"
						style="background: linear-gradient(to top left, #dc2626 50%, #f9fafb 50%);"
					></span>
					<span>Wisseldag (aankomst / vertrek)</span>
				</div>
			</div>
		</div>

		{calendarYears.map(({ year, months }) => (
			<div class="availability-view">
				<h2 class="calendar-year-heading">{year}</h2>
				<div class="calendar-grid">
					{months.map(({ monthName, days }) => (
						<div class="calendar-month">
							<h3>{monthName}</h3>
							<div class="calendar-days">
								<div class="day-header">Ma</div>
								<div class="day-header">Di</div>
								<div class="day-header">Wo</div>
								<div class="day-header">Do</div>
								<div class="day-header">Vr</div>
								<div class="day-header">Za</div>
								<div class="day-header">Zo</div>
								{days.map(
									({
										day,
										status,
										changeoverType,
										startStatus,
										endStatus,
									}) => (
										<div
											class:list={[
												"calendar-day",
												{
													empty: !day,
													booked: status,
													"changeover-start":
														changeoverType ===
														"start",
													"changeover-end":
														changeoverType ===
														"end",
													"changeover-both":
														changeoverType ===
														"both",
												},
											]}
											style={
												changeoverType === "both" &&
												startStatus &&
												endStatus
													? `--changeover-end: ${getStatusColor(
															endStatus,
														)}; --changeover-start: ${getStatusColor(
															startStatus,
														)}; color: white;`
													: status && !changeoverType
														? `background-color: ${getStatusColor(status)}; color: white;`
														: ""
											}
											data-status={status}
											title={
												changeoverType === "both" &&
												startStatus &&
												endStatus
													? `Vertrek: ${getStatusLabel(
															endStatus,
														)} • Aankomst: ${getStatusLabel(startStatus)}`
													: status
														? getStatusLabel(status)
														: ""
											}
										>
											{day || ""}
										</div>
									),
								)}
							</div>
						</div>
					))}
				</div>
			</div>
		))}

		<h3 class="text-center italic">Welkom in de mooie Morvan!</h3>
	</div>
</BaseLayout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1rem;
		.intro-block {
			background-color: #ffffff;
			border: 1px solid #e5e7eb;
			border-radius: 0.5rem;
			padding: 2rem;
			margin-bottom: 2rem;
		}

		.content {
			padding: 0;
			margin-bottom: 1.5rem;
		}

		.legend {
			display: flex;
			gap: 2rem;
			flex-wrap: wrap;
			padding-top: 1.5rem;
			border-top: 1px solid #e5e7eb;
		}
		border-radius: 0.5rem;
		margin-bottom: 2rem;
	}

	.legend-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.legend-color {
		width: 24px;
		height: 24px;
		border-radius: 4px;
		display: inline-block;
	}

	.availability-view {
		margin: 2rem 0;
	}

	.calendar-year-heading {
		font-size: 1.5rem;
		color: #1f2937;
		text-align: center;
		margin-bottom: 0.5rem;
	}

	.calendar-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.calendar-month {
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 0.5rem;
		padding: 0.75rem;
	}

	.calendar-month h3 {
		font-size: 1rem;
		margin-bottom: 0.75rem;
		color: #1f2937;
		text-align: center;
	}

	.calendar-days {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 2px;
	}

	.day-header {
		text-align: center;
		font-weight: 600;
		font-size: 0.875rem;
		color: #6b7280;
		padding: 0.5rem 0;
	}

	.calendar-day {
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.875rem;
		background-color: #f9fafb;
		border-radius: 4px;
		cursor: default;
		transition: all 0.2s;
		position: relative;
	}

	.calendar-day.empty {
		background-color: transparent;
	}

	.calendar-day.booked {
		font-weight: 600;
	}

	/* Changeover days - triangle backgrounds */

	/* End date (checkout) - triangle in top-left */
	.calendar-day.changeover-end {
		color: white !important;
		-webkit-text-stroke: 0.75px rgba(0, 0, 0, 0.35);
	}

	.calendar-day.changeover-end[data-status="gereserveerd"] {
		background: linear-gradient(
			to bottom right,
			var(--color-reserved) 50%,
			var(--color-calendar-background) 50%
		) !important;
	}

	.calendar-day.changeover-end[data-status="optie"] {
		background: linear-gradient(
			to bottom right,
			var(--color-option) 50%,
			var(--color-calendar-background) 50%
		) !important;
	}

	.calendar-day.changeover-end[data-status="geblokkeerd"] {
		/* background: linear-gradient(
			to bottom right,
			#4b5563 50%,
			#f9fafb 50%
		) !important; */
		background: var(--color-blocked);
	}

	/* Start date (checkin) - triangle in bottom-right */
	.calendar-day.changeover-start {
		color: white !important;
		-webkit-text-stroke: 0.75px rgba(0, 0, 0, 0.35);
	}

	.calendar-day.changeover-start[data-status="gereserveerd"] {
		background: linear-gradient(
			to top left,
			var(--color-reserved) 50%,
			var(--color-calendar-background) 50%
		) !important;
	}

	.calendar-day.changeover-start[data-status="optie"] {
		background: linear-gradient(
			to top left,
			var(--color-option) 50%,
			var(--color-calendar-background) 50%
		) !important;
	}

	.calendar-day.changeover-start[data-status="geblokkeerd"] {
		/* background: linear-gradient(
			to top left,
			var(--color-blocked) 50%,
			var(--color-calendar-background) 50%
		) !important; */
		background: var(--color-blocked);
	}

	/* Both start and end (same day checkout and checkin) - two triangles */
	.calendar-day.changeover-both {
		color: white !important;
		-webkit-text-stroke: 0.75px rgba(0, 0, 0, 0.35);
		background:
			linear-gradient(
				to bottom right,
				var(--changeover-end, var(--color-reserved)) 47%,
				transparent 47%
			),
			linear-gradient(
				to top left,
				var(--changeover-start, var(--color-reserved)) 47%,
				transparent 47%
			),
			var(--color-calendar-background) !important;
	}

	/* Full booked days (not changeover) get solid color */
	.calendar-day.booked:not(.changeover-start):not(.changeover-end):not(
			.changeover-both
		)[data-status="gereserveerd"] {
		background-color: var(--color-reserved);
		color: white;
	}

	.calendar-day.booked:not(.changeover-start):not(.changeover-end):not(
			.changeover-both
		)[data-status="optie"] {
		background-color: var(--color-option);
		color: white;
	}

	.calendar-day.booked:not(.changeover-start):not(.changeover-end):not(
			.changeover-both
		)[data-status="geblokkeerd"] {
		background-color: var(--color-blocked);
		color: white;
	}

	.calendar-day:not(.empty):not(.booked):hover {
		background-color: #e5e7eb;
	}

	.text-center {
		text-align: center;
	}

	.italic {
		font-style: italic;
	}

	@media (max-width: 768px) {
		.calendar-grid {
			grid-template-columns: 1fr;
		}

		.legend {
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
