---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'kaart');
const { Content } = await page.render();

const leftSidebar = [
  { src: '/images/hondmorvan-kaartlinks1.png', alt: 'HondMorvan kaart links' }
];

const rightSidebar = [
  { src: '/images/hondmorvan-kaartrechts1.png', alt: 'HondMorvan kaart rechts 1' },
  { src: '/images/hondmorvan-kaartrechts4.png', alt: 'HondMorvan kaart rechts 4' },
  { src: '/images/hondmorvan-kaartrechts3.png', alt: 'HondMorvan kaart rechts 3' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
