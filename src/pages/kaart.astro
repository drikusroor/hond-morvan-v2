---
import PageWithSidebars from '../layouts/PageWithSidebars.astro';
import { getEntry } from 'astro:content';
import { IMAGES } from '../utils/images';

const page = await getEntry('pages', 'kaart');
const { Content } = await page.render();

const leftSidebar = [
  { src: IMAGES.KAART_LEFT_1, alt: 'HondMorvan kaart links 1' },
  { src: IMAGES.KAART_LEFT_2, alt: 'HondMorvan kaart links 2' }
];

const rightSidebar = [
  { src: IMAGES.KAART_RIGHT_1, alt: 'HondMorvan kaart rechts 1' },
  { src: IMAGES.KAART_RIGHT_2, alt: 'HondMorvan kaart rechts 2' },
  { src: IMAGES.KAART_RIGHT_3, alt: 'HondMorvan kaart rechts 3' }
];
---

<PageWithSidebars title={page.data.title} description={page.data.description} leftSidebar={leftSidebar} rightSidebar={rightSidebar}>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
