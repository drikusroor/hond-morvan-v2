---
import PageWithSidebars from "../layouts/PageWithSidebars.astro";
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const page = await getEntry("pages", "kaart");

if (!page) {
  throw new Error("Page 'kaart' not found");
}

const { Content } = await page.render();
---

<PageWithSidebars
  title={page.data.title}
  description={page.data.description}
  headerImage={page.data.headerImage}
  leftSidebar={page.data.leftColumnImages}
  rightSidebar={page.data.rightColumnImages}
>
  <article class="content">
    <Content />
  </article>
</PageWithSidebars>

<style>
  .content {
    padding: 0;
  }
</style>
