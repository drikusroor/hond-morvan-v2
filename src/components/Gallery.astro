---
import { Image } from "astro:assets";
import { getImage } from "../utils/images";

interface Props {
    images: string[];
}

const { images = [] } = Astro.props;
---

{
    images.length > 0 && (
        <div class="gallery" id="gallery">
            {images.map((imagePath, index) => (
                <div class="gallery-item" data-index={index}>
                    <Image
                        src={getImage(imagePath)}
                        alt="Gallery image"
                        class="gallery-image"
                    />
                </div>
            ))}
        </div>
    )
}

<div id="lightbox" class="lightbox" style="display: none;">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox-prev" aria-label="Previous">&larr;</button>
    <button class="lightbox-next" aria-label="Next">&rarr;</button>
    <img src="" alt="Enlarged image" class="lightbox-image" />
</div>

<script>
    const gallery = document.getElementById("gallery");
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = lightbox?.querySelector(".lightbox-image") as HTMLImageElement;
    const closeBtn = lightbox?.querySelector(".lightbox-close");
    const prevBtn = lightbox?.querySelector(".lightbox-prev");
    const nextBtn = lightbox?.querySelector(".lightbox-next");

    let currentIndex = 0;
    let images: NodeListOf<HTMLImageElement> | null = null;

    if (gallery) {
        images = gallery.querySelectorAll(".gallery-image");

        gallery.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const item = target.closest(".gallery-item") as HTMLElement;
            
            if (item) {
                currentIndex = parseInt(item.dataset.index || "0");
                showLightbox();
            }
        });
    }

    function showLightbox() {
        if (!images || !lightbox || !lightboxImage) return;
        
        const img = images[currentIndex];
        lightboxImage.src = img.src;
        lightbox.style.display = "flex";
        document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
        if (!lightbox) return;
        lightbox.style.display = "none";
        document.body.style.overflow = "";
    }

    function showPrevious() {
        if (!images) return;
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        showLightbox();
    }

    function showNext() {
        if (!images) return;
        currentIndex = (currentIndex + 1) % images.length;
        showLightbox();
    }

    closeBtn?.addEventListener("click", closeLightbox);
    prevBtn?.addEventListener("click", showPrevious);
    nextBtn?.addEventListener("click", showNext);

    lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) {
            closeLightbox();
        }
    });

    document.addEventListener("keydown", (e) => {
        if (lightbox?.style.display === "flex") {
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowLeft") showPrevious();
            if (e.key === "ArrowRight") showNext();
        }
    });
</script>

<style>
    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
        padding: 1rem 0;
    }

    .gallery-item {
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        background: white;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        cursor: pointer;
    }

    .gallery-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .gallery-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        aspect-ratio: 4 / 3;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .gallery {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 0.75rem;
        }
    }

    @media (max-width: 480px) {
        .gallery {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }
    }

    /* Lightbox styles */
    .lightbox {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.9);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

    .lightbox-image {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
        border-radius: 4px;
    }

    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
        position: absolute;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        font-size: 2rem;
        cursor: pointer;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        transition: background 0.2s ease;
        color: #333;
    }

    .lightbox-close:hover,
    .lightbox-prev:hover,
    .lightbox-next:hover {
        background: white;
    }

    .lightbox-close {
        top: 1rem;
        right: 1rem;
    }

    .lightbox-prev {
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
    }

    .lightbox-next {
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
    }

    @media (max-width: 768px) {
        .lightbox-prev,
        .lightbox-next {
            font-size: 1.5rem;
            padding: 0.25rem 0.75rem;
        }

        .lightbox-close {
            font-size: 1.5rem;
            padding: 0.25rem 0.75rem;
        }
    }
</style>
